{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "noEmit": false,
    "sourceMap": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "typeRoots": ["../../node_modules/@types", "node_modules/@types"],
    "paths": {
      "@discord-clone/shared": ["../../packages/shared/dist/index.d.ts"]
    }
  },

  "include": ["src/**/*.ts"]
}

