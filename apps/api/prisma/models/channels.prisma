enum ChannelType {
  TEXT
  VOICE
  FORUM
  STAGE
  ANNOUNCEMENT
  DECISION
}

model ChannelCategory {
  id        String    @id @default(cuid())
  serverId  String
  name      String
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channels  Channel[]

  @@index([serverId, position])
}

model Channel {
  id                        String                      @id @default(cuid())
  serverId                  String
  categoryId                String?
  name                      String
  type                      ChannelType                 @default(TEXT)
  topic                     String?
  avatarUrl                 String?
  position                  Int                         @default(0)
  isPrivate                 Boolean                     @default(false)
  slowmodeSeconds           Int                         @default(0)
  /// Members must have `User.ageConfirmedAt` set to read or post (docs/features/age-restricted-channels.md).
  isAgeRestricted           Boolean                     @default(false)
  /// Opt-in per channel by a `ManageChannels` holder (docs/features/e2ee-key-management.md).
  isEncrypted               Boolean                     @default(false)
  /// Bumped on member removal to force a fresh content key; an ordering hint, not a key identity.
  encryptionKeyVersion      Int                         @default(0)
  /// Shown above the new-post form of a FORUM channel; null on every other type.
  postGuidelines            String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  server                    Server                      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  category                  ChannelCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  messages                  Message[]
  threads                   Thread[]
  pins                      MessagePin[]
  permissionOverrides       ChannelPermissionOverride[]
  readStates                ReadState[]
  notificationPreferences   NotificationPreference[]
  pushNotificationThrottles PushNotificationThrottle[]
  events                    ServerEvent[]
  scheduledMessages         ScheduledMessage[]
  autoModAlertRules         AutoModRule[]
  forumTags                 ForumTag[]
  webhooks                  ServerWebhook[]             @relation("WebhookChannel")
  /// Follow rows (`ServerWebhook.sourceChannelId`) of other channels following this ANNOUNCEMENT channel.
  followers                 ServerWebhook[]             @relation("WebhookSourceChannel")
  stageSpeakers             StageSpeaker[]
  stageSpeakRequests        StageSpeakRequest[]
  decisions                 Decision[]
  encryptionKeys            EncryptedChannelKey[]

  @@unique([serverId, name])
  @@index([categoryId])
}

model ChannelPermissionOverride {
  id        String        @id @default(cuid())
  channelId String
  roleId    String?
  memberId  String?
  allow     String[]      @default([])
  deny      String[]      @default([])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  channel   Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  role      Role?         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  member    ServerMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([roleId])
  @@index([memberId])
}

model ReadState {
  id                String   @id @default(cuid())
  userId            String
  channelId         String
  lastReadMessageId String?
  lastReadAt        DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel           Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId, lastReadAt])
}

/// A STAGE channel's current speaker roster (not call history). Removed by the kick/ban path, since
/// the user cascade only fires on account deletion.
model StageSpeaker {
  channelId String
  userId    String
  addedAt   DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

/// Pending "request to speak" entries of a STAGE channel's audience.
model StageSpeakRequest {
  channelId   String
  userId      String
  requestedAt DateTime @default(now())
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}
